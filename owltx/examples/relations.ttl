###  http://snomed.info/id/373080008
sct:373080008 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( sct:64572001    ### Disease
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty sct:609096000 ;    ### Role group
                                                            owl:someValuesFrom [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty sct:116676008 ;        ### Associated morphology
                                                                                                        owl:someValuesFrom sct:1240414004 ]   ###  Malignant neoplasm
                                                                                                      [ rdf:type owl:Restriction ;
                                                                                                        owl:onProperty sct:363698007 ;        ### Finding site
                                                                                                        owl:someValuesFrom sct:19100000 ]) ;  ### Structure of lower inner quadrant of breast
                                                                                 rdf:type owl:Class ] ] ) ;
                                     rdf:type owl:Class ] ;
               rdfs:label "Malignant neoplasm of lower inner quadrant of breast (disorder)"@en ;
               skos:altLabel "Malignant neoplasm of breast lower inner quadrant"@en ;
               skos:prefLabel "Malignant neoplasm of lower inner quadrant of breast"@en .


