###  http://snomed.info/id/67734004
<http://snomed.info/id/67734004> rdf:type owl:Class ;
                                 rdfs:subClassOf [ owl:intersectionOf ( <http://snomed.info/id/70104002>
                                                                        <http://snomed.info/id/816094009>
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] ;
                                 rdfs:label "Structure of thoracic segment of trunk (body structure)" ;
                                 skos:altLabel "Structure of thoracic segment of trunk" ,
                                               "Upper trunk" ,
                                               "Upper trunk structure" ;
                                 skos:definition "This segment relates to the volume of the trunk that is bounded by and includes: superiorly the thoracic inlet; inferiorly the thoracic diaphragm; posteriorly the spinal column and back of the thorax; and laterally the chest wall: it contains the thoracic cavity and contents, and includes all the overlying muscles, skin and subcutaneous tissue." ;
                                 skos:prefLabel "Thoracic segment of trunk" .


