###  http://snomed.info/id/67734004
sct:67734004 rdf:type owl:Class ;
             rdfs:subClassOf [ owl:intersectionOf ( sct:70104002    ### Upper body part structure
                                                    sct:816094009 ) ;    ### Cross-sectional thorax
                               rdf:type owl:Class ] ;
             rdfs:label "Structure of thoracic segment of trunk (body structure)"@en ;
